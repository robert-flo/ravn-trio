#!/usr/bin/env bash

# shellcheck disable=SC2034,SC2154 # Globals are shared with runtime/lib/trio_*.sh.
# Start command module: crea o reutiliza el workspace herdr del trío (PM, WK, RV).
#
# Crea o reutiliza un workspace en herdr con tres tabs independientes a pantalla completa:
# - pm: agente PM-<proyecto> (panel PM-<ticket>, nombre herdr pm-<proyecto>-<ticket>)
# - wk: agente WK-<proyecto> (panel WK-<ticket>, nombre herdr wk-<proyecto>-<ticket>)
# - rv: agente RV-<proyecto> (panel RV-<ticket>, nombre herdr rv-<proyecto>-<ticket>)
#
# Además fija la identidad git del meta-repo y del miembro (TRIO_GIT_NAME/EMAIL)
# y envía al PM el prompt de arranque (trio-pm-prompt.md) una sola vez por ticket:
# el marcador es <proyecto>/.trio/<ticket>/status.json.
set -Eeuo pipefail

module_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091 # Resolved from the project root.
source "$module_dir/../helper/set_variable.sh"
PROJECT_DIR="$TRIO_RUNTIME_DIR"
# shellcheck disable=SC1091
source "$PROJECT_DIR/lib/presentation.sh"
# shellcheck disable=SC1091
source "$PROJECT_DIR/lib/trio_project.sh"
# shellcheck disable=SC1091
source "$PROJECT_DIR/lib/trio_config.sh"
# shellcheck disable=SC1091
source "$PROJECT_DIR/lib/trio_herdr.sh"
# shellcheck disable=SC1091
source "$PROJECT_DIR/lib/trio_agy.sh"

mostrar_uso() {
    cat <<'EOF'
Uso: pj-trio [start] [--dry-run] [--no-kickoff] [--print-kickoff] <proyecto> <ticket> [--repo <miembro>]

Argumentos:
  <proyecto>        Ruta o nombre del proyecto meta (pj-*).
                    Si se pasa solo el nombre, se busca en $PJ_TRIO_ROOT,
                    en el directorio padre de $PWD o en /z-drive/tries.
  <ticket>          Identificador numérico o alfanumérico del ticket / issue.

Opciones:
  --repo <miembro>  Repositorio miembro del proyecto (hermano, subdirectorio o ruta).
                    Se pasa a cada agente mediante --add-dir.
  --dry-run         Muestra los comandos sin ejecutarlos.
  --no-kickoff      No envía el prompt de arranque al PM.
  --print-kickoff   Imprime el prompt de arranque del PM y sale (no toca herdr).
  -h, --help        Muestra esta ayuda.
EOF
}

# 1. Parseo de argumentos
dry_run=0
kickoff=1
print_kickoff=0
repo_arg=""
positional=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run)
            dry_run=1
            shift
            ;;
        --no-kickoff)
            kickoff=0
            shift
            ;;
        --print-kickoff)
            print_kickoff=1
            shift
            ;;
        --repo)
            if [[ $# -lt 2 ]]; then
                print_error "--repo requiere un argumento." >&2
                exit 1
            fi
            repo_arg="$2"
            shift 2
            ;;
        --repo=*)
            repo_arg="${1#*=}"
            shift
            ;;
        -h|--help)
            mostrar_uso
            exit 0
            ;;
        -*)
            print_error "opción desconocida '$1'" >&2
            mostrar_uso >&2
            exit 1
            ;;
        *)
            positional+=("$1")
            shift
            ;;
    esac
done

if [[ ${#positional[@]} -ne 2 ]]; then
    print_error "se requieren exactamente dos argumentos posicionales (<proyecto> y <ticket>)." >&2
    mostrar_uso >&2
    exit 1
fi

proyecto_arg="${positional[0]}"
ticket="${positional[1]}"


trio_resolver_proyecto
trio_cargar_config
trio_nombres
trio_localizar_recursos

if [[ "$print_kickoff" -eq 1 ]]; then
    renderizar_kickoff
    exit $?
fi

# 7. Modo --dry-run
verificar_agentes_disponibles

# Con --repo, los agentes abren en el clon del miembro (el meta-repo va por --add-dir).
work_dir="${repo_path:-$project_dir}"
echo "Directorio de trabajo de los agentes: $work_dir${repo_path:+ (miembro; meta-repo $project_dir vía --add-dir)}"

if [[ "$dry_run" -eq 1 ]]; then
    echo "[dry-run] Proyecto resuelto: $project_dir ($project_name)"
    if [[ -n "$repo_path" ]]; then
        echo "[dry-run] Repositorio miembro: $repo_path ($repo_name)"
    fi
    echo "[dry-run] Workspace label: $ws_label"
    echo "[dry-run] Configuración (capas, la última gana): $config_file"
    echo "[dry-run] Kinds: PM='${PM_KIND}' WK='${WK_KIND}' RV='${RV_KIND}'"
    echo ""
    instalar_integraciones
    echo "[dry-run] herdr workspace create --cwd \"$work_dir\" --label \"$ws_label\" --no-focus"
    echo "[dry-run] herdr tab rename \"<id_tab_pm>\" pm"
    echo "[dry-run] herdr pane rename \"<id_pane_pm>\" \"PM-${ticket}\""
    echo "[dry-run] herdr tab create --workspace \"<id_ws>\" --cwd \"$work_dir\" --label wk --no-focus"
    echo "[dry-run] herdr pane rename \"<id_pane_wk>\" \"WK-${ticket}\""
    echo "[dry-run] herdr tab create --workspace \"<id_ws>\" --cwd \"$work_dir\" --label rv --no-focus"
    echo "[dry-run] herdr pane rename \"<id_pane_rv>\" \"RV-${ticket}\""

    for role in PM WK RV; do
        role_lower=$(echo "$role" | tr '[:upper:]' '[:lower:]')
        k=""
        an=""
        case "$role" in
            PM) k="$PM_KIND"; an="$agent_pm" ;;
            WK) k="$WK_KIND"; an="$agent_wk" ;;
            RV) k="$RV_KIND"; an="$agent_rv" ;;
        esac
        if [[ -n "$k" ]]; then
            extra_args="-- --agent \"${role}-${project_name}\""
            if [[ -n "$repo_path" ]]; then
                extra_args="$extra_args --add-dir \"$project_dir\""
            fi
            if [[ "$role" == PM && "$k" == agy ]] && kickoff_pendiente; then
                extra_args="$extra_args -i \"Lee y segui al pie de la letra las instrucciones de arranque del archivo ${trio_dir}/kickoff.md\""
                kickoff_en_arranque=1
            fi
            echo "[dry-run] herdr agent start \"$an\" --kind \"$k\" --pane \"<id_pane_${role_lower}>\" $extra_args"
        else
            echo "[dry-run] # ${role}_KIND vacío: se deja el shell en tab ${role_lower}"
        fi
    done

    fijar_identidad_git
    enviar_kickoff

    echo ""
    echo "Workspace ID: <simulado> ($ws_label)"
    echo "Tabs y roles:"
    echo "  - pm: PM-${ticket} ($agent_pm) en <id_pane_pm>"
    echo "  - wk: WK-${ticket} ($agent_wk) en <id_pane_wk>"
    echo "  - rv: RV-${ticket} ($agent_rv) en <id_pane_rv>"
    echo "Comando para adjuntarte:"
    echo "  herdr workspace focus <simulado> && herdr"
    exit 0
fi

# 8. Verificación de herdr
if ! command -v herdr >/dev/null 2>&1; then
    print_error "el comando 'herdr' no está instalado en el PATH." >&2
    exit 1
fi

if ! ws_list_json="$(herdr workspace list 2>&1)"; then
    print_error "no se pudo comunicar con el servidor de herdr." >&2
    print_info "Detalle: $ws_list_json" >&2
    print_info "Asegurate de que el servidor esté activo ejecutando 'herdr server' o abriendo 'herdr'." >&2
    exit 1
fi

# 9. Instalación de integraciones e identidad git
instalar_integraciones
fijar_identidad_git

# 10. Creación o reutilización del workspace y tabs (idempotente)
existing_ws_id="$(echo "$ws_list_json" | jq -r --arg label "$ws_label" '.result.workspaces[]? | select(.label == $label) | .workspace_id' | head -n 1)"

ws_id=""
pm_tab=""
pm_pane=""
wk_tab=""
wk_pane=""
rv_tab=""
rv_pane=""

if [[ -n "$existing_ws_id" ]]; then
    ws_id="$existing_ws_id"
    tabs_json="$(herdr tab list --workspace "$ws_id")"
    panes_json="$(herdr pane list --workspace "$ws_id")"

    # Tab PM
    pm_tab="$(echo "$tabs_json" | jq -r '.result.tabs[]? | select(.label == "pm") | .tab_id' | head -n 1)"
    if [[ -z "$pm_tab" ]]; then
        first_tab="$(echo "$tabs_json" | jq -r '.result.tabs[0]?.tab_id // empty')"
        if [[ -n "$first_tab" ]]; then
            pm_tab="$first_tab"
            herdr tab rename "$pm_tab" pm >/dev/null
        else
            pm_create="$(herdr tab create --workspace "$ws_id" --cwd "$work_dir" --label pm --no-focus)"
            pm_tab="$(echo "$pm_create" | jq -r '.result.tab.tab_id')"
            pm_pane="$(echo "$pm_create" | jq -r '.result.root_pane.pane_id')"
        fi
    fi
    if [[ -z "$pm_pane" ]]; then
        pm_pane="$(echo "$panes_json" | jq -r --arg t "$pm_tab" '.result.panes[]? | select(.tab_id == $t) | .pane_id' | head -n 1)"
    fi
    if [[ -n "$pm_pane" ]]; then
        herdr pane rename "$pm_pane" "PM-${ticket}" >/dev/null
    fi

    # Tab WK
    wk_tab="$(echo "$tabs_json" | jq -r '.result.tabs[]? | select(.label == "wk") | .tab_id' | head -n 1)"
    if [[ -z "$wk_tab" ]]; then
        wk_create="$(herdr tab create --workspace "$ws_id" --cwd "$work_dir" --label wk --no-focus)"
        wk_tab="$(echo "$wk_create" | jq -r '.result.tab.tab_id')"
        wk_pane="$(echo "$wk_create" | jq -r '.result.root_pane.pane_id')"
    else
        wk_pane="$(echo "$panes_json" | jq -r --arg t "$wk_tab" '.result.panes[]? | select(.tab_id == $t) | .pane_id' | head -n 1)"
    fi
    if [[ -n "$wk_pane" ]]; then
        herdr pane rename "$wk_pane" "WK-${ticket}" >/dev/null
    fi

    # Tab RV
    rv_tab="$(echo "$tabs_json" | jq -r '.result.tabs[]? | select(.label == "rv") | .tab_id' | head -n 1)"
    if [[ -z "$rv_tab" ]]; then
        rv_create="$(herdr tab create --workspace "$ws_id" --cwd "$work_dir" --label rv --no-focus)"
        rv_tab="$(echo "$rv_create" | jq -r '.result.tab.tab_id')"
        rv_pane="$(echo "$rv_create" | jq -r '.result.root_pane.pane_id')"
    else
        rv_pane="$(echo "$panes_json" | jq -r --arg t "$rv_tab" '.result.panes[]? | select(.tab_id == $t) | .pane_id' | head -n 1)"
    fi
    if [[ -n "$rv_pane" ]]; then
        herdr pane rename "$rv_pane" "RV-${ticket}" >/dev/null
    fi
else
    create_json="$(herdr workspace create --cwd "$work_dir" --label "$ws_label" --no-focus)"
    if echo "$create_json" | jq -e '.error' >/dev/null 2>&1; then
        err_msg="$(echo "$create_json" | jq -r '.error.message // .error.code')"
        print_error "Error al crear el workspace en herdr: $err_msg" >&2
        exit 1
    fi

    ws_id="$(echo "$create_json" | jq -r '.result.workspace.workspace_id')"
    pm_tab="$(echo "$create_json" | jq -r '.result.tab.tab_id')"
    pm_pane="$(echo "$create_json" | jq -r '.result.root_pane.pane_id')"
    herdr tab rename "$pm_tab" pm >/dev/null
    herdr pane rename "$pm_pane" "PM-${ticket}" >/dev/null

    wk_create="$(herdr tab create --workspace "$ws_id" --cwd "$work_dir" --label wk --no-focus)"
    if echo "$wk_create" | jq -e '.error' >/dev/null 2>&1; then
        err_msg="$(echo "$wk_create" | jq -r '.error.message // .error.code')"
        print_error "Error al crear tab wk: $err_msg" >&2
        exit 1
    fi
    wk_tab="$(echo "$wk_create" | jq -r '.result.tab.tab_id')"
    wk_pane="$(echo "$wk_create" | jq -r '.result.root_pane.pane_id')"
    herdr pane rename "$wk_pane" "WK-${ticket}" >/dev/null

    rv_create="$(herdr tab create --workspace "$ws_id" --cwd "$work_dir" --label rv --no-focus)"
    if echo "$rv_create" | jq -e '.error' >/dev/null 2>&1; then
        err_msg="$(echo "$rv_create" | jq -r '.error.message // .error.code')"
        print_error "Error al crear tab rv: $err_msg" >&2
        exit 1
    fi
    rv_tab="$(echo "$rv_create" | jq -r '.result.tab.tab_id')"
    rv_pane="$(echo "$rv_create" | jq -r '.result.root_pane.pane_id')"
    herdr pane rename "$rv_pane" "RV-${ticket}" >/dev/null
fi

# Asegurar IDs de paneles si hicieron falta en reutilización
if [[ -z "$pm_pane" || -z "$wk_pane" || -z "$rv_pane" ]]; then
    fresh_panes="$(herdr pane list --workspace "$ws_id")"
    if [[ -z "$pm_pane" && -n "$pm_tab" ]]; then
        pm_pane="$(echo "$fresh_panes" | jq -r --arg t "$pm_tab" '.result.panes[]? | select(.tab_id == $t) | .pane_id' | head -n 1)"
        [[ -n "$pm_pane" ]] && herdr pane rename "$pm_pane" "PM-${ticket}" >/dev/null
    fi
    if [[ -z "$wk_pane" && -n "$wk_tab" ]]; then
        wk_pane="$(echo "$fresh_panes" | jq -r --arg t "$wk_tab" '.result.panes[]? | select(.tab_id == $t) | .pane_id' | head -n 1)"
        [[ -n "$wk_pane" ]] && herdr pane rename "$wk_pane" "WK-${ticket}" >/dev/null
    fi
    if [[ -z "$rv_pane" && -n "$rv_tab" ]]; then
        rv_pane="$(echo "$fresh_panes" | jq -r --arg t "$rv_tab" '.result.panes[]? | select(.tab_id == $t) | .pane_id' | head -n 1)"
        [[ -n "$rv_pane" ]] && herdr pane rename "$rv_pane" "RV-${ticket}" >/dev/null
    fi
fi


pm_duplicado=0
iniciar_agente_rol "PM" "$pm_pane" "$PM_KIND"
iniciar_agente_rol "WK" "$wk_pane" "$WK_KIND"
iniciar_agente_rol "RV" "$rv_pane" "$RV_KIND"

enviar_kickoff

# 12. Salida final
cat <<EOF
Workspace ID: $ws_id ($ws_label)
Tabs y roles:
  - pm: PM-${ticket} ($agent_pm) en $pm_pane
  - wk: WK-${ticket} ($agent_wk) en $wk_pane
  - rv: RV-${ticket} ($agent_rv) en $rv_pane
Comando para adjuntarte:
  herdr workspace focus $ws_id && herdr
EOF

#!/usr/bin/env bash

# Watch command module: observa cambios en <proyecto>/.trio/*/status.json y salud de sub-PMs.
# shellcheck disable=SC2034,SC2154 # Globals are shared with runtime/lib/trio_project.sh.
set -Eeuo pipefail

module_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091 # Resolved from the project root.
source "$module_dir/../helper/set_variable.sh"
PROJECT_DIR="$TRIO_RUNTIME_DIR"
# shellcheck disable=SC1091
source "$PROJECT_DIR/lib/presentation.sh"
# shellcheck disable=SC1091
source "$PROJECT_DIR/lib/trio_project.sh"

show_watch_help() {
  print_section "Watch Usage"
  cat <<'HELP_EOF'
  Uso: pj-trio watch [<proyecto>] [--ticket <clave[,clave...]>] [--snapshot <archivo>] [--timeout <seg>] [--verbose] [--json]

  Argumentos:
    <proyecto>            Ruta o nombre del proyecto meta (pj-* / HR-*).
                          Si se omite, se usa el Home Repo del directorio actual
                          o de un ancestro (proyecto.yml y/o .trio/, nombre HR-* /
                          pj-* o `proyecto:` en proyecto.yml). Si no hay o es
                          ambiguo, falla pidiendo <proyecto>.

  Opciones:
    --ticket <clave>      Filtra por clave o número de ticket (repetible o separado por comas).
    --snapshot <archivo>  Archivo JSON de snapshot previo/actual para detectar cambios inmediatos.
    --timeout <seg>       Tiempo máximo de espera en segundos (default: 1800). Sale con 124 si vence.
    --verbose             Despierta también en cambios de paso o tickets nuevos no terminales.
    --json                Imprime el resultado como JSON.
    -h, --help            Muestra esta ayuda.
HELP_EOF
}

snapshot_file=""
timeout_sec=1800
verbose=0
json_out=0
ticket_filters=()
positional=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ticket)
      if [[ $# -lt 2 ]]; then
        print_error "--ticket requiere una clave o lista separada por comas." >&2
        exit 1
      fi
      trio_parse_ticket_arg "$2" || exit 1
      shift 2
      ;;
    --snapshot)
      if [[ $# -lt 2 || -z "${2:-}" ]]; then
        print_error "--snapshot requiere un archivo." >&2
        exit 1
      fi
      snapshot_file="$2"
      shift 2
      ;;
    --timeout)
      if [[ $# -lt 2 || ! "${2:-}" =~ ^[0-9]+$ || "${2:-0}" -le 0 ]]; then
        print_error "--timeout requiere un entero positivo en segundos." >&2
        exit 1
      fi
      timeout_sec="$2"
      shift 2
      ;;
    --verbose)
      verbose=1
      shift
      ;;
    --json)
      json_out=1
      shift
      ;;
    -h|--help)
      show_watch_help
      exit 0
      ;;
    --)
      shift
      positional+=("$@")
      break
      ;;
    -*)
      print_error "opción desconocida: $1" >&2
      exit 1
      ;;
    *)
      positional+=("$1")
      shift
      ;;
  esac
done

if ! trio_proyecto_desde_args "${positional[@]}"; then
  show_watch_help >&2
  exit 1
fi
repo_arg=""
ticket=""
export PJ_TRIO_NO_CLONE="${PJ_TRIO_NO_CLONE:-1}"
trio_resolver_proyecto

collect_snapshot() {
  local -a fleet_args=("$project_dir" --json --no-gh)
  local f fleet_json
  for f in "${ticket_filters[@]}"; do
    fleet_args+=(--ticket "$f")
  done

  fleet_json="$("$module_dir/fleet" "${fleet_args[@]}" 2>/dev/null || echo "[]")"
  if ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"$fleet_json"; then
    fleet_json="[]"
  fi

  jq -S '
    reduce .[] as $it ({}; . + {
      ($it.clave): {
        clave: $it.clave,
        ticket: ($it.ticket // $it.clave),
        estado: ($it.estado // ""),
        estado_real: ($it.estado_real // ""),
        paso: ($it.paso // ""),
        step: ($it.step // ""),
        owner: ($it.owner // ""),
        pm_agent: ($it.pm_agent // ""),
        pm_herdr_status: ($it.pm_herdr_status // ""),
        workspace_id: ($it.workspace_id // ""),
        session: ($it.session // ""),
        pr: ($it.pr // ""),
        head: ($it.head // ""),
        merge_danger: ($it.merge_danger // ""),
        timestamp: ($it.timestamp // "")
      }
    })
  ' <<<"$fleet_json"
}

diff_snapshots() {
  local prev_json="$1"
  local curr_json="$2"
  local mode_verbose="${3:-$verbose}"
  jq -n --argjson prev "$prev_json" --argjson curr "$curr_json" --argjson verbose "$mode_verbose" '
    def is_actionable_real($r):
      ($r == "sin-cuota" or $r == "colgado" or $r == "muerto" or $r == "terminado" or $r == "trabado");

    [
      ($curr | keys_unsorted[]) as $k
      | ($prev[$k] // null) as $p
      | $curr[$k] as $c
      | ($c.estado_real // "") as $cr
      | ($p.estado_real // "") as $pr
      | select(
          if $verbose == 1 then
            ($p == null)
            or ($c.estado != $p.estado)
            or ($c.paso != $p.paso)
            or (($cr != $pr) and is_actionable_real($cr))
            or (($c.pm_herdr_status != $p.pm_herdr_status) and ($c.pm_herdr_status == "blocked" or $c.pm_herdr_status == "unknown"))
          else
            if $p == null then
              ($c.estado == "hecho" or $c.estado == "needs-roberto" or $c.estado == "blocked")
              or is_actionable_real($cr)
              or ($c.estado == "en-curso" and ($c.pm_herdr_status == "blocked" or $c.pm_herdr_status == "unknown"))
            else
              (($c.estado != $p.estado) and ($c.estado == "hecho" or $c.estado == "needs-roberto" or $c.estado == "blocked"))
              or (($cr != $pr) and is_actionable_real($cr))
              or ($c.estado == "en-curso" and ($c.pm_herdr_status != $p.pm_herdr_status) and ($c.pm_herdr_status == "blocked" or $c.pm_herdr_status == "unknown"))
            end
          end
        )
      | {
          clave: $c.clave,
          ticket: $c.ticket,
          tipo: (
            if $p == null then "nuevo"
            elif $c.estado != $p.estado then "estado"
            elif ($cr != $pr) and is_actionable_real($cr) then "estado_real"
            elif $c.paso != $p.paso then "paso"
            else "pm_herdr_status"
            end
          ),
          estado: $c.estado,
          estado_real: $cr,
          paso: $c.paso,
          pm_agent: $c.pm_agent,
          pm_herdr_status: $c.pm_herdr_status,
          session: ($c.session // ""),
          prev_estado: ($p.estado // ""),
          prev_estado_real: $pr,
          prev_paso: ($p.paso // ""),
          prev_pm_herdr_status: ($p.pm_herdr_status // ""),
          pr: $c.pr,
          head: $c.head,
          merge_danger: $c.merge_danger
        }
    ]
  '
}

confirm_events_with_gh() {
  local prev_json="$1"
  local curr_json="$2"
  local events_json="$3"
  local mode_verbose="${4:-$verbose}"
  command -v gh >/dev/null 2>&1 || { confirmed_snapshot="$curr_json"; confirmed_events="$events_json"; return 0; }

  local updated_snap="$curr_json"
  local any_updated=0
  local count i ev clave estado estado_real fresh_json fresh_item
  count="$(jq 'length' <<<"$events_json")"
  for (( i = 0; i < count; i++ )); do
    ev="$(jq -c ".[$i]" <<<"$events_json")"
    clave="$(jq -r '.clave // ""' <<<"$ev")"
    estado="$(jq -r '.estado // ""' <<<"$ev")"
    estado_real="$(jq -r '.estado_real // ""' <<<"$ev")"

    if [[ "$estado" != "hecho" && ( "$estado_real" == "muerto" || "$estado_real" == "colgado" ) ]]; then
      fresh_json="$("$module_dir/fleet" "$project_dir" --json --ticket "$clave" 2>/dev/null || echo "[]")"
      fresh_item="$(jq -c '.[0] // empty' <<<"$fresh_json" 2>/dev/null || true)"
      if [[ -n "$fresh_item" ]] && [[ "$(jq -r '.estado_real // ""' <<<"$fresh_item")" == "terminado" ]]; then
        updated_snap="$(jq -S --arg k "$clave" --argjson it "$fresh_item" '
          .[$k] = (.[$k] + {
            estado_real: ($it.estado_real // ""),
            step: ($it.step // ""),
            pr: ($it.pr // .[$k].pr)
          })
        ' <<<"$updated_snap")"
        any_updated=1
      fi
    fi
  done

  confirmed_snapshot="$updated_snap"
  if [[ "$any_updated" -eq 1 ]]; then
    confirmed_events="$(diff_snapshots "$prev_json" "$updated_snap" "$mode_verbose")"
  else
    confirmed_events="$events_json"
  fi
}

write_snapshot() {
  local snap="$1"
  [[ -n "$snapshot_file" ]] || return 0
  mkdir -p "$(dirname "$snapshot_file")"
  printf '%s\n' "$snap" > "$snapshot_file"
}

enrich_and_emit() {
  local events_json="$1"
  local enriched="[]"
  local count i ev estado estado_real pm_status pm_agent ev_session tail_out

  count="$(jq 'length' <<<"$events_json")"
  for (( i = 0; i < count; i++ )); do
    ev="$(jq -c ".[$i]" <<<"$events_json")"
    estado="$(jq -r '.estado // ""' <<<"$ev")"
    estado_real="$(jq -r '.estado_real // ""' <<<"$ev")"
    pm_status="$(jq -r '.pm_herdr_status // ""' <<<"$ev")"
    pm_agent="$(jq -r '.pm_agent // ""' <<<"$ev")"
    ev_session="$(jq -r '.session // ""' <<<"$ev")"
    tail_out=""

    if [[ "$estado" == "needs-roberto" || "$estado" == "blocked" || "$pm_status" == "blocked" || "$pm_status" == "unknown" || "$estado_real" == "sin-cuota" || "$estado_real" == "colgado" || "$estado_real" == "muerto" || "$estado_real" == "trabado" ]]; then
      if [[ -n "$pm_agent" ]] && command -v herdr >/dev/null 2>&1; then
        tail_out="$(trio_herdr_cmd "$ev_session" agent read "$pm_agent" 2>/dev/null | tail -n 25 || true)"
      fi
    fi

    ev="$(jq -n --argjson ev "$ev" --arg tail "$tail_out" '$ev + {tail: $tail}')"
    enriched="$(jq -n --argjson arr "$enriched" --argjson ev "$ev" '$arr + [$ev]')"
  done

  if [[ "$json_out" -eq 1 ]]; then
    jq -n --argjson events "$enriched" '{status: "changed", events: $events}'
    return 0
  fi

  print_section "Watch — ${project_name}"
  for (( i = 0; i < count; i++ )); do
    ev="$(jq -c ".[$i]" <<<"$enriched")"
    local clave tipo paso prev_estado prev_estado_real prev_paso prev_pm
    clave="$(jq -r '.clave' <<<"$ev")"
    tipo="$(jq -r '.tipo' <<<"$ev")"
    estado="$(jq -r '.estado' <<<"$ev")"
    estado_real="$(jq -r '.estado_real // ""' <<<"$ev")"
    paso="$(jq -r '.paso' <<<"$ev")"
    pm_status="$(jq -r '.pm_herdr_status' <<<"$ev")"
    pm_agent="$(jq -r '.pm_agent' <<<"$ev")"
    prev_estado="$(jq -r '.prev_estado' <<<"$ev")"
    prev_estado_real="$(jq -r '.prev_estado_real // ""' <<<"$ev")"
    prev_paso="$(jq -r '.prev_paso' <<<"$ev")"
    prev_pm="$(jq -r '.prev_pm_herdr_status' <<<"$ev")"
    tail_out="$(jq -r '.tail' <<<"$ev")"

    printf '  %s [%s]: estado=%s real=%s paso=%s pm=%s\n' \
      "$clave" "$tipo" "${estado:--}" "${estado_real:--}" "${paso:--}" "${pm_status:--}"
    if [[ "$tipo" == "estado" ]]; then
      printf '    estado: %s -> %s\n' "${prev_estado:--}" "${estado:--}"
    elif [[ "$tipo" == "estado_real" ]]; then
      printf '    estado_real: %s -> %s\n' "${prev_estado_real:--}" "${estado_real:--}"
    elif [[ "$tipo" == "paso" ]]; then
      printf '    paso: %s -> %s\n' "${prev_paso:--}" "${paso:--}"
    elif [[ "$tipo" == "pm_herdr_status" ]]; then
      printf '    pm: %s -> %s\n' "${prev_pm:--}" "${pm_status:--}"
    fi
    if [[ -n "$tail_out" ]]; then
      printf '    --- últimas líneas de %s ---\n' "$pm_agent"
      while IFS= read -r line; do
        printf '    %s\n' "$line"
      done <<<"$tail_out"
    fi
  done
}

emit_confirmed_events() {
  local prev_json="$1"
  local curr_json="$2"
  local events_json="$3"
  local mode_verbose="${4:-$verbose}"
  local save_snap="${5:-1}"

  confirm_events_with_gh "$prev_json" "$curr_json" "$events_json" "$mode_verbose"
  curr_snapshot="$confirmed_snapshot"
  events="$confirmed_events"
  if [[ "$save_snap" -eq 1 ]]; then
    write_snapshot "$curr_snapshot"
  fi
  enrich_and_emit "$events"
}

curr_snapshot="$(collect_snapshot)"

if [[ -n "$snapshot_file" && -f "$snapshot_file" ]]; then
  if prev_snapshot="$(jq -e '.' "$snapshot_file" 2>/dev/null)"; then
    events="$(diff_snapshots "$prev_snapshot" "$curr_snapshot")"
    if [[ "$(jq 'length' <<<"$events")" -gt 0 ]]; then
      emit_confirmed_events "$prev_snapshot" "$curr_snapshot" "$events" "$verbose" 1
      exit 0
    fi
  else
    print_warn "snapshot previo inválido en ${snapshot_file}; se reinicia." >&2
  fi
elif [[ -z "$snapshot_file" && ${#ticket_filters[@]} -gt 0 ]]; then
  events="$(diff_snapshots "{}" "$curr_snapshot" 0)"
  if [[ "$(jq 'length' <<<"$events")" -gt 0 ]]; then
    emit_confirmed_events "{}" "$curr_snapshot" "$events" 0 0
    exit 0
  fi
fi

write_snapshot "$curr_snapshot"
baseline="$curr_snapshot"

interval="${PJ_TRIO_WATCH_INTERVAL:-30}"
if [[ ! "$interval" =~ ^[0-9]+$ || "$interval" -le 0 ]]; then
  interval=30
fi

start_ts="$(date +%s)"
while true; do
  now="$(date +%s)"
  elapsed=$(( now - start_ts ))
  remaining=$(( timeout_sec - elapsed ))
  if [[ "$remaining" -le 0 ]]; then
    if [[ "$json_out" -eq 1 ]]; then
      jq -n --argjson t "$timeout_sec" '{status: "timeout", timeout: $t, events: []}'
    else
      print_warn "Timeout (${timeout_sec}s) sin cambios en ${project_name}." >&2
    fi
    exit 124
  fi

  cycle=$(( remaining < interval ? remaining : interval ))
  if [[ -d "$project_dir/.trio" ]] && command -v inotifywait >/dev/null 2>&1; then
    inotifywait -e modify,create,moved_to -r -q -t "$cycle" "$project_dir/.trio" >/dev/null 2>&1 || true
  else
    sleep "$cycle"
  fi

  curr_snapshot="$(collect_snapshot)"
  events="$(diff_snapshots "$baseline" "$curr_snapshot")"
  if [[ "$(jq 'length' <<<"$events")" -gt 0 ]]; then
    emit_confirmed_events "$baseline" "$curr_snapshot" "$events" "$verbose" 1
    exit 0
  fi
  if [[ "$curr_snapshot" != "$baseline" ]]; then
    write_snapshot "$curr_snapshot"
  fi
  baseline="$curr_snapshot"
done
